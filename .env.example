# Base de datos
DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# LLM (opcional solo para personalización de descripciones)
LLM_PROVIDER=              # "koboldcpp" o "api" (tipo chat_completions)
LLM_API_KEY=               
LLM_BASE_URL=              # e.g. https://your-endpoint.openai.azure.com/openai/deployments/gpt-4.1
LLM_MODEL=                 # e.g. gpt-4.1
KOBOLD_DESC_URL=           # e.g. http://localhost:5001/api/v1/generate
KOBOLD_SQL_URL=            # e.g. http://localhost:5002/api/v1/generate

# Semáforo para llamadas al LLM (limitar concurrencia y mitigar errores 429)
LLM_MAX_CONCURRENCY=2      # Número máximo de peticiones simultáneas al LLM
